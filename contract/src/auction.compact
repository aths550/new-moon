// Sealed-Bid Auction Smart Contract in Compact
// Enables privacy-preserving commit-reveal bidding with Merkle allowlist access control.
// ONLY the current highest bid is written to the ledger during the Reveal phase.

pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  Commit,
  Reveal,
  Ended
}

export ledger state: State;
export ledger itemDescription: Opaque<"string">;
export ledger sellerPublicKey: Bytes<32>;
export ledger allowlistMerkleRoot: Bytes<32>;
export ledger highestBidCommitment: Bytes<32>;
export ledger highestBidAmount: Uint<64>;
export ledger winnerRevealed: Boolean;
export ledger winningAmount: Uint<64>;
export ledger commitments: Map<Bytes<32>, Bytes<32>>;

constructor(item: Opaque<"string">, merkleRoot: Bytes<32>) {
  state = State.Commit;
  itemDescription = disclose(item);
  allowlistMerkleRoot = disclose(merkleRoot);
  highestBidAmount = 0;
  winnerRevealed = false;
  winningAmount = 0;
}

witness localSecretKey(): Bytes<32>;
witness localMerklePath(): Vector<8, Bytes<32>>;
witness localPathDirections(): Vector<8, Boolean>;
witness localBidAmount(): Uint<64>;
witness localBidSalt(): Bytes<32>;

export circuit updateAllowlistRoot(newRoot: Bytes<32>): [] {
  allowlistMerkleRoot = disclose(newRoot);
}

export circuit commitBid(commitmentHash: Bytes<32>): [] {
  assert(state == State.Commit, "Auction is not in Commit phase");

  const sk = localSecretKey();
  const merklePath = localMerklePath();
  const pathDirections = localPathDirections();

  const leaf = persistentHash<Bytes<32>>(sk);

  const h0 = pathDirections[0]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[0], leaf])
    : persistentHash<[Bytes<32>, Bytes<32>]>([leaf, merklePath[0]]);
  const h1 = pathDirections[1]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[1], h0])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h0, merklePath[1]]);
  const h2 = pathDirections[2]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[2], h1])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h1, merklePath[2]]);
  const h3 = pathDirections[3]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[3], h2])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h2, merklePath[3]]);
  const h4 = pathDirections[4]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[4], h3])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h3, merklePath[4]]);
  const h5 = pathDirections[5]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[5], h4])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h4, merklePath[5]]);
  const h6 = pathDirections[6]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[6], h5])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h5, merklePath[6]]);
  const h7 = pathDirections[7]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[7], h6])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h6, merklePath[7]]);

  assert(h7 == allowlistMerkleRoot, "identity not in authorized allowlist");

  const nullifier = persistentHash<Vector<2, Bytes<32>>>([pad(32, "auction:nullifier:"), leaf]);
  assert(!commitments.member(disclose(nullifier)), "Identity has already committed a bid");

  commitments.insert(disclose(nullifier), disclose(commitmentHash));
}

export circuit advanceToReveal(): [] {
  assert(state == State.Commit, "Auction is not in Commit phase");
  state = State.Reveal;
}

export circuit revealBid(): [] {
  assert(state == State.Reveal, "Auction is not in Reveal phase");

  const sk = localSecretKey();
  const merklePath = localMerklePath();
  const pathDirections = localPathDirections();

  const leaf = persistentHash<Bytes<32>>(sk);

  const h0 = pathDirections[0]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[0], leaf])
    : persistentHash<[Bytes<32>, Bytes<32>]>([leaf, merklePath[0]]);
  const h1 = pathDirections[1]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[1], h0])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h0, merklePath[1]]);
  const h2 = pathDirections[2]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[2], h1])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h1, merklePath[2]]);
  const h3 = pathDirections[3]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[3], h2])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h2, merklePath[3]]);
  const h4 = pathDirections[4]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[4], h3])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h3, merklePath[4]]);
  const h5 = pathDirections[5]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[5], h4])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h4, merklePath[5]]);
  const h6 = pathDirections[6]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[6], h5])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h5, merklePath[6]]);
  const h7 = pathDirections[7]
    ? persistentHash<[Bytes<32>, Bytes<32>]>([merklePath[7], h6])
    : persistentHash<[Bytes<32>, Bytes<32>]>([h6, merklePath[7]]);

  assert(h7 == allowlistMerkleRoot, "identity not in authorized allowlist");

  const nullifier = persistentHash<Vector<2, Bytes<32>>>([pad(32, "auction:nullifier:"), leaf]);
  assert(commitments.member(disclose(nullifier)), "No commitment found for identity");

  const amount = localBidAmount();
  const salt = localBidSalt();

  const computedCommitment = persistentHash<[Bytes<32>, Uint<64>]>([salt, amount]);
  const storedCommitment = commitments.lookup(disclose(nullifier));
  assert(computedCommitment == storedCommitment, "Revealed amount and salt do not match commitment");

  if (disclose(amount > highestBidAmount)) {
    highestBidAmount = disclose(amount);
    highestBidCommitment = storedCommitment;
  }
}

export circuit closeAuction(): [] {
  assert(state == State.Reveal, "Auction is not in Reveal phase");
  state = State.Ended;
  if (highestBidAmount > 0) {
    winnerRevealed = true;
    winningAmount = highestBidAmount;
  }
}

export pure circuit computeCommitment(salt: Bytes<32>, amount: Uint<64>): Bytes<32> {
  return persistentHash<[Bytes<32>, Uint<64>]>([salt, amount]);
}
